{
  "version": "0.2",
  "language": "en",
  "globRoot": "${cwd}",
  "useGitignore": true,
  "files": [
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "cli/README.md",
    "adapters/**/README.md"
  ],
  "ignoreRegExpList": [
    "/`[^`]*`/g",
    "/```[\\s\\S]*?```/g",
    "Urls",
    "Email"
  ],
