{
  "name": "barry",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "changeset": "node .github/ci/changeset.mjs",
    "build": "pnpm stores:generate && pnpm -r build",
    "build:packages": "node sdk/scripts/build-packages.mjs",
    "check:prompt-instructions": "node .github/ci/run.mjs check:prompt-instructions",
    "check:node-version": "node .github/ci/run.mjs check:node-version",
    "check:workflow-security": "node .github/ci/run.mjs check:workflow-security",
    "check:monorepo": "node .github/ci/run.mjs check:monorepo",
    "check:package-consumers": "node .github/ci/run.mjs check:package-consumers",
    "check:bag-host-reach": "node .github/ci/run.mjs check:bag-host-reach",
    "check:barry-home": "node .github/ci/run.mjs check:barry-home",
    "check:service-addresses": "node .github/ci/run.mjs check:service-addresses",
    "check:vendor-neutral": "node .github/ci/run.mjs check:vendor-neutral",
    "check:bag-data-dirs": "node .github/ci/run.mjs check:bag-data-dirs",
    "check:stale-paths": "node .github/ci/run.mjs check:stale-paths",
    "check:identity-residue": "node .github/ci/run.mjs check:identity-residue",
    "check:bound-vocabulary": "node .github/ci/run.mjs check:bound-vocabulary",
    "check:doc-links": "node .github/ci/run.mjs check:doc-links",
    "check:workflow-triggers": "node .github/ci/run.mjs check:workflow-triggers",
    "contracts:generate": "pnpm --dir cli generate:openapi && pnpm --dir sdk generate",
    "contracts:check": "pnpm --dir cli check:openapi && pnpm --dir sdk check:generated",
    "test": "pnpm test:ci:unit",
    "test:ci:unit": "node .github/ci/run.mjs test:ci:unit",
    "test:ci:integration": "pnpm --dir sdk test",
    "test:ci": "pnpm test:ci:unit && pnpm test:ci:integration",
    "test:soak": "tsx bags/workflows/src/load-probe.ts 600",
    "test:soak:overnight": "tsx bags/workflows/src/load-probe.ts 28800",
    "ci:verify:static": "node .github/ci/checks/static-gate.mjs",
    "ci:verify": "pnpm run ci:verify:static && pnpm test:ci:unit",
    "barry": "node cli/bin/barry.js",
    "dev": "BARRY_HOME=\"$PWD/.barry-dev\" node cli/bin/barry.js up",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:eslint && pnpm spell:check",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint --cache-strategy content --max-warnings=0",
    "lint:eslint:ci": "node --test .github/ci/run.test.mjs && node .github/ci/run.mjs lint:eslint:ci",
    "knip": "knip --config knip.ts --reporter compact",
    "security:dependencies": "node .github/ci/run.mjs security:dependencies",
    "security:licenses": "node .github/ci/run.mjs security:licenses",
    "security:secrets": "node .github/ci/run.mjs security:secrets",
    "stores:generate": "node --import tsx sdk/scripts/generate-store-migrations.ts",
    "stores:check": "node --import tsx sdk/scripts/generate-store-migrations.ts --check",
    "check:sdk-package": "node .github/ci/checks/sdk-package.mjs",
    "check:adapter-packages": "node .github/ci/checks/adapter-packages.mjs",
    "check:artifacts-package": "node .github/ci/checks/artifacts-package.mjs",
    "format:check": "node .github/ci/checks/format.mjs",
    "format": "node .github/ci/checks/format.mjs --write",
    "spell:check": "cspell --config cspell.json --no-progress",
    "workspace:generate": "node .github/ci/checks/workspace-entries.mjs --write",
    "workspace:check": "node .github/ci/checks/workspace-entries.mjs",
    "check:package-aliases": "node .github/ci/checks/package-aliases.mjs",
    "bags:lint": "node .github/ci/checks/bag-shape.mjs",
    "check:stale-references": "node .github/ci/run.mjs check:stale-references"
  },
  "engines": {
    "node": ">=26.9 <27",
    "pnpm": "12.x"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "cspell": "10.3.6",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "knip": "^6.41.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "yaml": "2.9.1",
    "@barry-rocks/sessions-bag": "workspace:@barry-rocks/sessions-bag@*"
  }
}
