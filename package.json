{
  "name": "barry",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm -r build",
    "build:apps": "echo 'build:apps: no app packages in this repo (ui moved to barry-web)'",
    "build:projects": "pnpm exec tsc -b tsconfig.projects.json",
    "build:projects:dry": "pnpm exec tsc -b tsconfig.projects.json --dry",
    "check:monorepo": "node .github/ci/run.mjs check:monorepo",
    "check:package-consumers": "node .github/ci/run.mjs check:package-consumers",
    "check:bag-host-reach": "node .github/ci/run.mjs check:bag-host-reach",
    "check:barry-home": "node .github/ci/run.mjs check:barry-home",
    "check:service-addresses": "node .github/ci/run.mjs check:service-addresses",
    "check:vendor-neutral": "node .github/ci/run.mjs check:vendor-neutral",
    "check:bag-data-dirs": "node .github/ci/run.mjs check:bag-data-dirs",
    "check:stale-paths": "node .github/ci/run.mjs check:stale-paths",
    "check:identity-residue": "node .github/ci/run.mjs check:identity-residue",
    "check:bound-vocabulary": "node .github/ci/run.mjs check:bound-vocabulary",
    "check:doc-links": "node .github/ci/run.mjs check:doc-links",
    "check:workflow-triggers": "node .github/ci/run.mjs check:workflow-triggers",
    "check:brewfile": "node .github/ci/run.mjs check:brewfile",
    "contracts:generate": "pnpm --dir sdk/lib generate",
    "contracts:check": "pnpm --dir sdk/lib check:generated",
    "test": "pnpm test:ci:unit",
    "test:ci:unit": "node .github/ci/run.mjs test:ci:unit",
    "test:ci:integration": "pnpm --dir sdk/cli test",
    "test:ci:targeted": "pnpm test:ci:unit",
    "test:ci": "pnpm test:ci:unit && pnpm test:ci:integration",
    "ci:verify:static": "pnpm check:monorepo && pnpm check:package-consumers && pnpm check:bag-host-reach && pnpm check:barry-home && pnpm check:service-addresses && pnpm check:vendor-neutral && pnpm check:bag-data-dirs && pnpm check:workflow-triggers && pnpm contracts:check && pnpm knip && pnpm security:dependencies && pnpm security:licenses && pnpm security:secrets && pnpm run build:projects && pnpm run build:apps",
    "ci:verify": "pnpm run ci:verify:static && pnpm test:ci:unit",
    "barry": "tsx sdk/cli/src/index.ts",
    "dev": "BARRY_HOME=\"$PWD/.barry-dev\" tsx sdk/cli/src/index.ts up",
    "clean": "pnpm -r exec rm -rf node_modules dist",
    "typecheck": "pnpm -r typecheck && pnpm run build:projects",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/eslint --cache-strategy content --max-warnings=0",
    "lint:eslint:ci": "node --test .github/ci/run.test.mjs && node .github/ci/run.mjs lint:eslint:ci",
    "knip": "knip --reporter compact",
    "lint:fix": "eslint . --fix && pnpm lint",
    "security:dependencies": "node .github/ci/run.mjs security:dependencies",
    "security:licenses": "node .github/ci/run.mjs security:licenses",
    "security:secrets": "node .github/ci/run.mjs security:secrets"
  },
  "engines": {
    "node": "26.x",
    "pnpm": "10.x"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "knip": "^6.27.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vitest": "4.1.0"
  }
}
