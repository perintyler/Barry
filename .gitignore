node_modules/
*.generated
.env
*.env
.dev.vars
/config.json
!.changeset/config.json
# Machine-local seed overrides (traits.local.yaml). Must be ignored BEFORE the
# file moves anywhere: these are workspace roots the mirror publishes whole, so
# a tracked local override would ship personal trait grants to a public repo.
.mcp.json
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secret*
!*secret*.test.ts
!*secret*.ts
# A tracked user guide, not a secret file (the broad *secret* rule above would hide it).
!docs/secrets.md
cookies.txt
dist/
*.tsbuildinfo
build/
*.js.map
*.log
*.log.*
logs/
# ...except the `logs` SUB-BAG, which is source, not log output. The rule above
# is unanchored, so it matches a `logs/` directory at ANY depth — it silently
# swallowed every file in bags/telemetry/logs/ (the log store). `git add`
# refuses an ignored path rather than failing quietly, which is the only reason
# this was caught; a commit would otherwise
# have landed with the sub-bag missing and the build still green locally.
!bags/telemetry/logs/
*.bak
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*.db
*.sqlite
*.sqlite3
tmp/
temp/
*.tmp
.playwright-mcp/
test-results/
.pnpm-store
**/package-lock.json
.barry
test-*.js
test-*.html
debug-*.js
debug-*.html
*-test.js
*-test.html
verify-*.js
*_old/
*.backup
# Backup artifacts, not source. A bare *backup* also swallows legitimate files
# such as cli/src/commands/vault-backup.ts.
*.backup.*
backups/
*-backup-[0-9]*
*~
.build/
DerivedData/
ModuleCache/
*.xcuserstate
*.pcm
*.swiftmodule
.claude/
# Nested feature checkouts are audited in their own worktree.
.worktrees/
bin/
# ...except the root wrappers and the CLI's entry points: `barry`, `barry-service` and `barry-hook`
# are source, and the rule above is unanchored.
!cli/bin/
!/bin/
.barry/
# `pnpm dev`'s contributor instance: its own home, stores, logs and worktrees
.barry-dev/
data/
.skills/
*.sauce.*
.swe/
.wrangler/
.codex*/
.barry/post-mortems/
NOTES.md

# Design mockups
**/design/*.html
**/design-system/*.html


# QA reports (generated by the /qa skill)
.qa-reports/


# release skill staging output (transient)
.release-staging/

# ClickHouse CLI tokens
.clickhouse/

# Generated by the slack team-activity skill (report output, not source)
team-activity-*.md

.design/

# Python virtualenv — local tooling, never shipped. Untracked, but knip walks
# the working tree rather than the index, so an unignored venv/ puts thousands
# of vendored site-packages files in front of every repo-wide check.
venv/

# Bag-owned terraform roots (same rules as the retired top-level infra/)
bags/*/infra/.terraform/
bags/*/infra/*.tfstate
bags/*/infra/*.tfstate.backup
bags/*/infra/*.tfvars
!bags/*/infra/*.tfvars.example

# SQL history in the logs bag is source, not a log directory.
!bags/telemetry/logs/migrations/logs/
!bags/telemetry/logs/migrations/logs/*.sql

plans/finalization/monitor/__pycache__/


# Package-local license copies are generated from the canonical root at prepack.
/adapters/completions/anthropic/LICENSE.md
/adapters/completions/llamacpp/LICENSE.md
/adapters/completions/ollama/LICENSE.md
/adapters/decisions/anthropic/LICENSE.md
/adapters/decisions/ollama/LICENSE.md
/adapters/decisions/systemone/LICENSE.md
/adapters/decisions/typesafe/LICENSE.md
/adapters/decisions/von/LICENSE.md
/adapters/embeddings/ollama/LICENSE.md
/adapters/sessions/antigravity/LICENSE.md
/adapters/sessions/claude/LICENSE.md
/adapters/sessions/codex/LICENSE.md
/adapters/sessions/cursor/LICENSE.md
/adapters/sessions/opencode/LICENSE.md
/adapters/sessions/pi/LICENSE.md
/bags/artifacts/LICENSE.md
/sdk/LICENSE.md
plans/
