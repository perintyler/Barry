# Design mockups
**/design/*.html
**/design-system/*.html

# Monaco editor bundle (regenerate with bags/bdiff/app/Scripts/bundle-monaco.sh)
bags/bdiff/app/Sources/Resources/monaco-diff.html


# QA reports (generated by the /qa skill)
.qa-reports/

# Review write-ups and the ledgers tracking them. Working artifacts of a
# review pass, not documentation of the system — they cite commit SHAs and
# findings that go stale the moment they are fixed, and docs/ ships to the
# public mirror.
docs/reviews/

# Playwright screenshot outputs
apps/web/barry.works/tests/screenshots/

# Artifacts app (in development, not yet part of the workspace)

# release skill staging output (transient)
.release-staging/

# ClickHouse CLI tokens
.clickhouse/

# Generated by the slack team-activity skill (report output, not source)
team-activity-*.md

# Design mockups — local scratch, not shipped
mockups/

# Python virtualenv — local tooling, never shipped. Untracked, but knip walks
# the working tree rather than the index, so an unignored venv/ puts thousands
# of vendored site-packages files in front of every repo-wide check.
venv/

# Bag-owned terraform roots (same rules as the retired top-level infra/)
bags/*/infra/.terraform/
bags/*/infra/*.tfstate
bags/*/infra/*.tfstate.backup
bags/*/infra/*.tfvars
!bags/*/infra/*.tfvars.example
