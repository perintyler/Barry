# Machine-local seed overrides (traits.local.yaml). Must be ignored BEFORE the
# file moves here: packages/ is a workspace root the mirror publishes whole, so
# a tracked local override would ship personal trait grants to a public repo.
packages/db/seed/*.local.yaml
