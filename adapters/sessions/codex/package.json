{
  "name": "@barry-rocks/session-codex",
  "version": "0.0.0",
  "description": "OpenAI Codex agent adapter for Barry",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./transcript": {
      "types": "./dist/transcript.d.ts",
      "import": "./dist/transcript.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../../.github/ci/prepare-package-license.mjs && node ../../scripts/build-package.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@barry-rocks/sdk": "workspace:*",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "files": [
    "dist",
    "bag.yaml",
    "README.md",
    "LICENSE.md"
  ],
  "barry": {
    "sessionAdapter": {
      "contractVersion": 1
    }
  },
  "private": true
}
