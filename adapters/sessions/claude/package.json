{
  "name": "@barry-rocks/session-claude",
  "version": "0.0.0",
  "description": "Claude agent adapter for Barry \u2014 the Claude Agent SDK and Anthropic-compatible backends",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native-tools": {
      "types": "./dist/native-tools.d.ts",
      "import": "./dist/native-tools.js"
    },
    "./transcript": {
      "types": "./dist/transcript.d.ts",
      "import": "./dist/transcript.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../../.github/ci/prepare-package-license.mjs && node ../../scripts/build-package.mjs"
  },
  "engines": {
    "node": "26.x"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@barry-rocks/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "files": [
    "dist",
    "bag.yaml",
    "README.md",
    "LICENSE.md"
  ],
  "barry": {
    "sessionAdapter": {
      "contractVersion": 1
    }
  },
  "private": true
}
