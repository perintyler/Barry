{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/__fixtures__/**",
    "src/**/*-fixture.ts",
    "node_modules",
    "dist"
  ]
}
