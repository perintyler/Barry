{
  "name": "@barry-rocks/sdk-artifacts",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Artifact list and file viewer components",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./styles": "./src/styles-bundle.css",
    "./styles-bundle.css": "./src/styles-bundle.css",
    "./styles/sdk-only": "./src/styles.css",
    "./css": "./dist/css.js",
    "./browser": "./dist/browser.js",
    "./browser-inline": "./dist/browser-inline.js",
    "./worker": "./src/worker/index.ts",
    "./utils": "./src/worker/file-utils.ts",
    "./mcp": "./src/mcp/index.ts",
    "./mcp/client": "./src/mcp/client.ts",
    "./mcp/server": "./src/mcp/server.ts",
    "./mcp/cloudflare": "./src/mcp/cloudflare.ts",
    "./mcp-app-viewer": "./dist/mcp-app-viewer.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "pretest": "pnpm --filter @barry-rocks/ui... build && node scripts/build.js && tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:consumer-deps": "node scripts/check-consumer-deps.mjs"
  },
  "dependencies": {
    "@barry-rocks/syntax": "workspace:*",
    "@barry-rocks/themes": "workspace:*",
    "@barry-rocks/ui": "workspace:*",
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/workers-oauth-provider": "^0.8.2",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@taga3s/highlightjs-terraform": "^1.0.7",
    "agents": "^0.13.3",
    "highlight.js": "11.11.1",
    "highlightjs-zig": "^1.0.2",
    "hono": "4.13.1",
    "markdown-it": "14.2.0",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-front-matter": "0.2.4",
    "markdown-it-task-lists": "2.1.1",
    "oauth4webapi": "^3.8.6",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "express": "5.2.1",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@types/express": "5.0.6",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.15.0",
    "esbuild": "0.27.0",
    "jsdom": "25.0.0",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
