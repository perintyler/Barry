{
  "name": "@barry-rocks/sdk-notes",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Single scratchpad notes component with persistent storage",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./styles": "./src/styles.css",
    "./css": "./dist/css.js",
    "./browser": "./dist/browser.js",
    "./browser-inline": "./dist/browser-inline.js",
    "./worker": "./src/worker/index.ts"
  },
  "files": [
