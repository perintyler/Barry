{
  "name": "@barry-rocks/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Barry's command line: barry, barry-service (what launchd runs) and barry-hook (what harness hooks run). A composition root: it imports the bags and adapters it drives, which the SDK must not.",
  "bin": {
    "barry": "bin/barry.js",
    "barry-service": "bin/barry-service.js",
    "barry-hook": "bin/barry-hook.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi": "tsx scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.1",
    "@barry-rocks/actions-bag": "workspace:*",
    "@barry-rocks/events-bag": "workspace:*",
    "@barry-rocks/identities-bag": "workspace:*",
    "@barry-rocks/schedules-bag": "workspace:*",
    "@barry-rocks/sdk": "workspace:*",
    "@barry-rocks/mcp-bag": "workspace:*",
    "@barry-rocks/sessions-bag": "workspace:*",
    "@barry-rocks/tracker-bag": "workspace:*",
    "@inquirer/core": "11.1.1",
    "@inquirer/figures": "2.0.3",
    "@inquirer/prompts": "8.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "commander": "12.0.0",
    "esbuild": "0.28.1",
    "express": "4.22.1",
    "kysely": "0.28.17",
    "tsx": "4.23.12",
    "ws": "8.21.0",
    "yaml": "2.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@barry-rocks/completion-anthropic": "workspace:*",
    "@barry-rocks/completion-llamacpp": "workspace:*",
    "@barry-rocks/completion-ollama": "workspace:*",
    "@barry-rocks/decision-anthropic": "workspace:*",
    "@barry-rocks/decision-ollama": "workspace:*",
    "@barry-rocks/decision-typesafe": "workspace:*",
    "@barry-rocks/decision-von": "workspace:*",
    "@barry-rocks/embedding-ollama": "workspace:*",
    "@barry-rocks/identities-service": "workspace:*",
    "@barry-rocks/session-claude": "workspace:*",
    "@barry-rocks/session-codex": "workspace:*",
    "@barry-rocks/session-cursor": "workspace:*",
    "@barry-rocks/session-opencode": "workspace:*",
    "@barry-rocks/sessions-api": "workspace:*",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "license": "SEE LICENSE IN ../LICENSE.md"
}
