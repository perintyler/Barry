<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.barry.caddy</string>
    <key>ProgramArguments</key>
    <array>
        <string>__BARRY_DIR__/bin/caddy</string>
        <string>run</string>
        <string>--config</string>
        <string>__BARRY_DIR__/config/Caddyfile</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.barry/logs/caddy.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.barry/logs/caddy.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CLOUDFLARE_API_TOKEN</key>
        <string>__CLOUDFLARE_API_TOKEN__</string>
    </dict>
</dict>
</plist>
