{
  "name": "@barry-rocks/mcp-server",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Barry MCP server \u2014 all tools in a single process",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "barry-mcp": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:http": "node ./scripts/build-bundle.mjs",
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/bundle.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@barry-rocks/agent-scope": "workspace:*",
    "@barry-rocks/auth": "workspace:*",
    "@barry-rocks/bags": "workspace:*",
    "@barry-rocks/db": "workspace:*",
    "@barry-rocks/env": "workspace:*",
    "@barry-rocks/file-tracker": "workspace:*",
    "@barry-rocks/locks-bag": "workspace:*",
    "@barry-rocks/logger": "workspace:*",
    "@barry-rocks/secrets": "workspace:*",
    "@barry-rocks/sentry": "workspace:*",
    "@barry-rocks/session-client": "workspace:*",
    "@barry-rocks/system-bag": "workspace:*",
    "@barry-rocks/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "express": "4.22.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
