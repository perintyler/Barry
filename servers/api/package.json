{
  "name": "barry-server",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.39.0",
    "@barry/agent-runtime": "workspace:*",
    "@barry/agent-scope": "workspace:*",
    "@barry/auth": "workspace:*",
    "@barry/contracts": "workspace:*",
    "@barry/db": "workspace:*",
    "@barry/env": "workspace:*",
    "@barry/file-tracker": "workspace:*",
    "@barry/logger": "workspace:*",
    "@barry/blocks": "workspace:*",
    "@barry/skills": "workspace:*",
    "@barry/secrets": "workspace:*",
    "@barry/sentry": "workspace:*",
    "@barry/sessions": "workspace:*",
    "express": "4.22.1",
    "express-rate-limit": "8.2.2",
    "ws": "8.21.0",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "@types/ws": "8.5.13",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
