{
  "name": "barry-server",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.117.1",
    "@barry-rocks/actions-bag": "workspace:*",
    "@barry-rocks/agent-runtime": "workspace:*",
    "@barry-rocks/agent-scope": "workspace:*",
    "@barry-rocks/auth": "workspace:*",
    "@barry-rocks/bags": "workspace:*",
    "@barry-rocks/contracts": "workspace:*",
    "@barry-rocks/db": "workspace:*",
    "@barry-rocks/env": "workspace:*",
    "@barry-rocks/file-tracker": "workspace:*",
    "@barry-rocks/usage-telemetry": "workspace:*",
    "@barry-rocks/logger": "workspace:*",
    "@barry-rocks/memory-bag": "workspace:*",
    "@barry-rocks/secrets": "workspace:*",
    "@barry-rocks/sentry": "workspace:*",
    "@barry-rocks/session-client": "workspace:*",
    "@barry-rocks/sessions": "workspace:*",
    "@barry-rocks/skills": "workspace:*",
    "express": "4.22.1",
    "express-rate-limit": "8.2.2",
    "ws": "8.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "@types/ws": "8.5.13",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
