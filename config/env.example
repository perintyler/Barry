# Barry daemon configuration. Copy to .env in the repo root or deploy directory.
# Provider, bag, deployment-tool, and other session credentials belong on profiles.

BARRY_ENV=prod
BARRY_DATABASE_URL=postgres://barry:barry@127.0.0.1:15432/barry?sslmode=require

# Where session/message writes go. "direct" (default) writes straight to
# Postgres — today's behavior. "http" routes them through the session bag's
# store service (write leases, batched persistence). Per PROCESS, so setting
# it here applies to the api; flip it back to direct to roll back instantly.
SESSION_STORE_TRANSPORT=direct
BARRY_SECRET=
BARRY_TRUST_PROXY=false
BARRY_CORS_ORIGINS=
BARRY_ALLOWED_NETWORKS=
# Bearer token gating the API and MCP servers (packages/auth).
BARRY_API_TOKEN=
# Comma-separated Tailscale addresses allowed through the network gate (packages/auth).
BARRY_TAILSCALE_IPS=

# NOTE: servers do NOT read these — they bind via the PORTS registry in
# packages/env/src/index.ts (+1000 prod offset). These vars exist for launchd
# templates and jobs that display or proxy ports; keep them matching the registry.
BARRY_WEB_PORT=9429
BARRY_API_PORT=4854
BARRY_GITHUB_APP_PORT=4861
BARRY_SLACK_PORT=4863
BARRY_MCP_PORT=4901

# Repository-development tooling (non-secret GitHub owner/repo slugs).
BARRY_PUBLIC_REPO=
BARRY_STAGING_REPO=

# Credentials consumed directly by long-running daemons.
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
SLACK_APP_URL=https://slack.barry.rocks
SLACK_APP_ID=
SLACK_CONFIG_TOKEN=
SLACK_CONFIG_REFRESH_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
MAILGUN_SIGNING_KEY=
MAILGUN_MAX_AGE_SECONDS=300
SENTRY_DSN=
SENTRY_WEB_DSN=

# Sender identity for outbound email (the resend bag). Config, not a secret —
# the Resend API key is a per-profile secret. Declared for the MCP server in
# cli/src/mcp-registry.ts.
BARRY_EMAIL_ADDRESS=

# Vault container bootstrap. Vault cannot retrieve the credentials used to start itself.
BARRY_VAULT_JWT_SECRET=
BARRY_VAULT_REGISTRATION_SECRET=
BARRY_VAULT_MASTER_PASSWORD=
BARRY_VAULT_EMAIL=
BARRY_VAULT_CLIENT_ID=
BARRY_VAULT_CLIENT_SECRET=
BARRY_VAULT_MCP_TOKEN=
# age public key vault backups are encrypted to (cli vault-backup).
BARRY_VAULT_AGE_RECIPIENT=

# Cloudflare deploys (`barry bag deploy`, worker deploy scripts).
BARRY_CLOUDFLARE_ACCOUNT_ID=
BARRY_CLOUDFLARE_DEPLOY_TOKEN=
