# Barry daemon configuration. Copy to .env in the repo root or deploy directory.
# Provider, block, deployment-tool, and other session credentials belong on profiles.

BARRY_ENV=prod
BARRY_DATABASE_URL=postgres://barry:barry@localhost:5433/barry
BARRY_SECRET=
BARRY_TRUST_PROXY=true
BARRY_CORS_ORIGINS=
BARRY_ALLOWED_NETWORKS=

BARRY_WEB_PORT=9429
BARRY_API_PORT=4854
BARRY_GITHUB_APP_PORT=4861
BARRY_WHISPERFLOW_PORT=9001
BARRY_BDIFF_REVIEW_PORT=4862
BARRY_SLACK_PORT=4863
BARRY_MCP_PORT=4901

# Repository-development tooling (non-secret GitHub owner/repo slugs).
BARRY_PUBLIC_REPO=
BARRY_STAGING_REPO=

# Credentials consumed directly by long-running daemons.
DEEPGRAM_API_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=
SLACK_APP_URL=https://slack.barry.rocks
SLACK_APP_ID=
SLACK_CONFIG_TOKEN=
SLACK_CONFIG_REFRESH_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
MAILGUN_SIGNING_KEY=
MAILGUN_MAX_AGE_SECONDS=300
SENTRY_DSN=
SENTRY_WEB_DSN=
AXIOM_TOKEN=

# Sender identity for outbound email (the resend block). Config, not a secret —
# the Resend API key is a per-profile secret. Declared for the MCP server in
# builtins/mcp-servers.yaml.
BARRY_EMAIL_ADDRESS=

# Vault container bootstrap. Vault cannot retrieve the credentials used to start itself.
BARRY_VAULT_JWT_SECRET=
BARRY_VAULT_REGISTRATION_SECRET=
BARRY_VAULT_MASTER_PASSWORD=
BARRY_VAULT_EMAIL=
BARRY_VAULT_CLIENT_ID=
BARRY_VAULT_CLIENT_SECRET=
BARRY_VAULT_MCP_TOKEN=
