{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Barry Design System — Design Tokens (DTCG format)",

  "primitive": {
    "$description": "Raw values. Never reference directly in components.",

    "color": {
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#000000" },

      "stone": {
        "50":  { "$type": "color", "$value": "#fafaf9" },
        "100": { "$type": "color", "$value": "#f5f5f4" },
        "200": { "$type": "color", "$value": "#e7e5e4" },
        "300": { "$type": "color", "$value": "#d6d3d1" },
        "400": { "$type": "color", "$value": "#a8a29e" },
        "500": { "$type": "color", "$value": "#78716c" },
        "600": { "$type": "color", "$value": "#57534e" },
        "700": { "$type": "color", "$value": "#44403c" },
        "800": { "$type": "color", "$value": "#292524" },
        "900": { "$type": "color", "$value": "#1c1917" },
        "950": { "$type": "color", "$value": "#0c0a09" }
      },

      "zinc": {
        "400": { "$type": "color", "$value": "#a1a1a6" },
        "500": { "$type": "color", "$value": "#6b6b70" },
        "600": { "$type": "color", "$value": "#52525b" },
        "800": { "$type": "color", "$value": "#1c1c1e" },
        "900": { "$type": "color", "$value": "#141415" },
        "950": { "$type": "color", "$value": "#0a0a0b" }
      },

      "blue": {
        "400": { "$type": "color", "$value": "#60a5fa" },
        "500": { "$type": "color", "$value": "#3b82f6" },
        "600": { "$type": "color", "$value": "#2563eb" }
      },

      "purple": {
        "400": { "$type": "color", "$value": "#a78bfa" },
        "500": { "$type": "color", "$value": "#8b5cf6" }
      }
    },

    "opacity": {
      "4":  { "$type": "number", "$value": 0.04 },
      "5":  { "$type": "number", "$value": 0.05 },
      "6":  { "$type": "number", "$value": 0.06 },
      "8":  { "$type": "number", "$value": 0.08 },
      "10": { "$type": "number", "$value": 0.10 },
      "12": { "$type": "number", "$value": 0.12 },
      "20": { "$type": "number", "$value": 0.20 },
      "25": { "$type": "number", "$value": 0.25 },
      "30": { "$type": "number", "$value": 0.30 },
      "40": { "$type": "number", "$value": 0.40 }
    },

    "size": {
      "32": { "$type": "dimension", "$value": "32px" },
      "36": { "$type": "dimension", "$value": "36px" }
    },

    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" }
    }
  },

  "semantic": {
    "$description": "Role-based tokens. These swap between modes.",

    "surface": {
      "primary": {
        "$type": "color",
        "$value": "{primitive.color.zinc.950}",
        "$extensions": { "mode": { "light": "{primitive.color.stone.50}" } }
      }
    },

    "text": {
      "primary": {
        "$type": "color",
        "$value": "#fafafa",
        "$extensions": { "mode": { "light": "{primitive.color.stone.900}" } }
      },
      "secondary": {
        "$type": "color",
        "$value": "{primitive.color.zinc.400}",
        "$extensions": { "mode": { "light": "{primitive.color.stone.600}" } }
      },
      "tertiary": {
        "$type": "color",
        "$value": "{primitive.color.zinc.500}",
        "$extensions": { "mode": { "light": "{primitive.color.stone.400}" } }
      },
      "muted": {
        "$type": "color",
        "$value": "{primitive.color.zinc.600}",
        "$extensions": { "mode": { "light": "{primitive.color.stone.300}" } }
      }
    },

    "border": {
      "default": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.08)",
        "$extensions": { "mode": { "light": "rgba(28, 25, 23, 0.08)" } }
      },
      "hover": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.12)",
        "$extensions": { "mode": { "light": "rgba(28, 25, 23, 0.15)" } }
      }
    }
  },

  "component": {
    "$description": "Component-specific tokens. Reference semantic or primitive tokens.",

    "action-btn": {
      "$description": "Circular action button used in GlassInput and toolbars.",

      "size": {
        "md": { "$type": "dimension", "$value": "{primitive.size.36}" },
        "sm": { "$type": "dimension", "$value": "{primitive.size.32}" }
      },
      "radius": { "$type": "dimension", "$value": "50%" },
      "transition": { "$type": "string", "$value": "150ms cubic-bezier(0.16, 1, 0.3, 1)" },
      "press-scale": { "$type": "number", "$value": 0.92 },

      "ghost": {
        "bg": {
          "$type": "color",
          "$value": "rgba(255, 255, 255, 0.06)",
          "$extensions": { "mode": { "light": "rgba(28, 25, 23, 0.05)" } }
        },
        "bg-hover": {
          "$type": "color",
          "$value": "rgba(255, 255, 255, 0.12)",
          "$extensions": { "mode": { "light": "rgba(28, 25, 23, 0.10)" } }
        },
        "fg": {
          "$type": "color",
          "$value": "{primitive.color.zinc.500}",
          "$extensions": { "mode": { "light": "{primitive.color.stone.400}" } }
        },
        "fg-hover": {
          "$type": "color",
          "$value": "{primitive.color.zinc.400}",
          "$extensions": { "mode": { "light": "{primitive.color.stone.500}" } }
        },
        "border": {
          "$type": "color",
          "$value": "rgba(255, 255, 255, 0.06)",
          "$extensions": { "mode": { "light": "rgba(28, 25, 23, 0.08)" } }
        }
      },

      "active": {
        "$description": "Toggled-on state, e.g. recording microphone.",
        "bg": {
          "$type": "color",
          "$value": "rgba(59, 130, 246, 0.20)",
          "$extensions": { "mode": { "light": "rgba(59, 130, 246, 0.10)" } }
        },
        "fg": {
          "$type": "color",
          "$value": "{primitive.color.blue.500}",
          "$extensions": { "mode": { "light": "{primitive.color.blue.600}" } }
        },
        "border": {
          "$type": "color",
          "$value": "rgba(59, 130, 246, 0.30)",
          "$extensions": { "mode": { "light": "rgba(59, 130, 246, 0.25)" } }
        }
      },

      "primary": {
        "$description": "Send button — gradient fill.",
        "gradient-start": {
          "$type": "color",
          "$value": "{primitive.color.blue.400}",
          "$extensions": { "mode": { "light": "{primitive.color.blue.500}" } }
        },
        "gradient-end": {
          "$type": "color",
          "$value": "{primitive.color.purple.400}",
          "$extensions": { "mode": { "light": "{primitive.color.purple.500}" } }
        },
        "fg": {
          "$type": "color",
          "$value": "{primitive.color.white}"
        },
        "glow-sm": {
          "$type": "shadow",
          "$value": { "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px", "color": "rgba(96, 165, 250, 0.25)" },
          "$extensions": {
            "mode": {
              "light": { "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px", "color": "rgba(59, 130, 246, 0.20)" }
            }
          }
        },
        "glow-md": {
          "$type": "shadow",
          "$value": { "offsetX": "0px", "offsetY": "2px", "blur": "16px", "spread": "0px", "color": "rgba(96, 165, 250, 0.40)" },
          "$extensions": {
            "mode": {
              "light": { "offsetX": "0px", "offsetY": "2px", "blur": "16px", "spread": "0px", "color": "rgba(59, 130, 246, 0.30)" }
            }
          }
        }
      },

      "disabled": {
        "bg": {
          "$type": "color",
          "$value": "rgba(255, 255, 255, 0.04)",
          "$extensions": { "mode": { "light": "rgba(28, 25, 23, 0.06)" } }
        },
        "fg": {
          "$type": "color",
          "$value": "{primitive.color.zinc.600}",
          "$extensions": { "mode": { "light": "{primitive.color.stone.300}" } }
        },
        "opacity": {
          "$type": "number",
          "$value": 0.4,
          "$description": "Applied to ghost variant only"
        }
      }
    }
  }
}
