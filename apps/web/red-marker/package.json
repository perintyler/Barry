  "license": "SEE LICENSE IN LICENSE.md",
  "description": "HTML annotation tool for visual feedback on articles and pages",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "redmark": "./bin/redmark"
  },
  "exports": {
