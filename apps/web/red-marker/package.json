  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260111.0",
    "@types/node": "22.15.0",
    "esbuild": "0.27.0",
    "typescript": "5.9.3",
    "wrangler": "4.59.1"
  },
  "optionalDependencies": {
    "playwright": "1.58.2"
  }
