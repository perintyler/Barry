{
  "name": "@barry-rocks/engine",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Barry MCP server \u2014 all tools in a single process",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "barry-mcp": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "build:http": "node ./scripts/build-bundle.mjs",
    "dev": "tsx --watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/bundle.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@barry-rocks/sdk": "workspace:*",
    "@barry-rocks/identities-bag": "workspace:*",
    "@barry-rocks/locks-bag": "workspace:*",
    "@barry-rocks/logs-bag": "workspace:*",
    "@barry-rocks/completion": "workspace:*",
    "@barry-rocks/decisions": "workspace:*",
    "@barry-rocks/embeddings": "workspace:*",
    "@barry-rocks/sdk": "workspace:*",
    "@barry-rocks/session-bag": "workspace:*",
    "@barry-rocks/tracker-bag": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.10.0",
    "express": "4.22.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
