{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mjs"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "node_modules",
    "dist",
    "src/**/*-fixture.ts",
    "src/**/*-fixture.mjs",
    "src/**/__fixtures__/**",
    "src/**/test-helpers/**"
  ]
}
