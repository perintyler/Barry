{
  "name": "@barry-rocks/md-to-ansi",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./markup": "./src/markup/index.ts",
    "./tui": "./src/tui/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./markup": {
        "types": "./dist/markup/index.d.ts",
        "default": "./dist/markup/index.js"
      },
      "./tui": {
        "types": "./dist/tui/index.d.ts",
        "default": "./dist/tui/index.js"
      }
    }
  },
  "description": "Convert Markdown to ANSI-colored terminal output"
}
