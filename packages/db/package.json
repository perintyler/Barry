{
  "name": "@barry-rocks/db",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./identity-bags": "./src/identity-bags.ts",
    "./qa": "./src/qa.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./scripts/seed.ts",
    "./test-db-url": "./src/test-db-url.ts",
    "./identity-files": "./src/identity-files.ts",
    "./bag-registry": "./src/bag-registry.ts"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:setup": "tsx scripts/setup-qa.ts",
    "qa:seed": "tsx scripts/setup-qa.ts",
    "backfill:provider-sessions": "tsx scripts/backfill-provider-sessions.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@barry-rocks/agent-scope": "workspace:*",
    "@barry-rocks/env": "workspace:*",
    "@barry-rocks/bags": "workspace:*",
    "kysely": "0.28.17",
    "kysely-postgres-js": "2.0.0",
    "nanoid": "5.0.9",
    "postgres": "3.4.8",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@barry-rocks/agent-runtime": "workspace:*",
    "@types/node": "22.15.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./identity-bags": {
        "types": "./dist/identity-bags.d.ts",
        "default": "./dist/identity-bags.js"
      },
      "./qa": {
        "types": "./dist/qa.d.ts",
        "default": "./dist/qa.js"
      },
      "./migrate": {
        "types": "./dist/migrate.d.ts",
        "default": "./dist/migrate.js"
      },
      "./seed": {
        "types": "./dist/seed.d.ts",
        "default": "./dist/seed.js"
      },
      "./test-db-url": {
        "types": "./dist/test-db-url.d.ts",
        "default": "./dist/test-db-url.js"
      },
      "./identity-files": {
        "types": "./dist/identity-files.d.ts",
        "default": "./dist/identity-files.js"
      },
      "./bag-registry": {
        "types": "./dist/bag-registry.d.ts",
        "default": "./dist/bag-registry.js"
      }
    }
  },
  "description": "Database schema, queries, and migrations for Barry"
}
