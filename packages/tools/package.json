{
  "name": "@barry-rocks/tools",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./define-tool": "./src/define-tool.ts",
    "./register": "./src/register.ts",
    "./truncate": "./src/truncate.ts",
    "./paths": "./src/paths.ts",
    "./mcp-adapter": "./src/mcp-adapter.ts",
    "./bag-server": "./src/bag-server.ts",
    "./cli-adapter": "./src/cli-adapter.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./define-tool": {
        "types": "./dist/define-tool.d.ts",
        "default": "./dist/define-tool.js"
      },
      "./register": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "./truncate": {
        "types": "./dist/truncate.d.ts",
        "default": "./dist/truncate.js"
      },
      "./paths": {
        "types": "./dist/paths.d.ts",
        "default": "./dist/paths.js"
      },
      "./mcp-adapter": {
        "types": "./dist/mcp-adapter.d.ts",
        "default": "./dist/mcp-adapter.js"
      },
      "./bag-server": {
        "types": "./dist/bag-server.d.ts",
        "default": "./dist/bag-server.js"
      },
      "./cli-adapter": {
        "types": "./dist/cli-adapter.d.ts",
        "default": "./dist/cli-adapter.js"
      }
    }
  }
}
