{
  "name": "@barry-rocks/contracts",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Runtime-validated HTTP, WebSocket, and persisted JSON contracts for Barry",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts",
    "./generated/openapi.json": "./generated/openapi.json"
  },
  "scripts": {
    "generate": "NODE_OPTIONS=--disable-warning=DEP0205 tsx scripts/generate-openapi.ts",
    "check:generated": "NODE_OPTIONS=--disable-warning=DEP0205 tsx scripts/generate-openapi.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./openapi": {
        "types": "./dist/openapi.d.ts",
        "default": "./dist/openapi.js"
      },
      "./generated/openapi.json": "./generated/openapi.json"
    }
  }
}
