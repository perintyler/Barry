{
  "name": "@barry/contracts",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Runtime-validated HTTP, WebSocket, and persisted JSON contracts for Barry",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.ts",
    "./generated/openapi.json": "./generated/openapi.json"
  },
  "scripts": {
    "generate": "NODE_OPTIONS=--disable-warning=DEP0205 tsx scripts/generate-openapi.ts",
    "check:generated": "NODE_OPTIONS=--disable-warning=DEP0205 tsx scripts/generate-openapi.ts --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
