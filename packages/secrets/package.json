{
  "name": "@barry-rocks/secrets",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./identity": "./src/identity.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@barry-rocks/bags": "workspace:*",
    "@barry-rocks/db": "workspace:*",
    "@barry-rocks/vault": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./identity": {
        "types": "./dist/identity.d.ts",
        "default": "./dist/identity.js"
      }
    }
  },
  "description": "Secret resolution from vault, keychain, and environment"
}
