{
  "name": "@barry-blocks/github-app",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Barry's GitHub App block - answers @barry mentions on issues and pull requests",
  "type": "module",
  "scripts": {
    "dev": "tsx --watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "start:prod": "tsx server/src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@barry/db": "workspace:*",
    "@barry/env": "workspace:*",
    "@barry/github": "workspace:*",
    "@barry/logger": "workspace:*",
    "@barry/secrets": "workspace:*",
    "express": "4.22.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "typescript": "5.9.3"
  },
  "private": true
}
