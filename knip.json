{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "eslint.config.js",
    ".github/ci/**/*.{js,mjs,ts}"
  ],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved"
  ],
  "ignoreDependencies": [
    "cloudflare"
  ],
  "ignoreUnresolved": [
    "^/spark\\.js$",
    "^/usr/bin/plutil$",
    "^/bin/launchctl$"
  ],
  "ignoreFiles": [
    "**/public/vendor/**",
    "**/*.generated.*",
    "**/generated/**",
    "sdk/lib/src/host/hook-dispatch.ts",
    "builtin/identities/scripts/audit-identity.ts",
    "builtin/actions/scripts/sync-skills.ts",
    "builtin/sessions/api/src/jobs/bookkeeping.ts",
    "**/*.test-d.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "eslint.config.js",
        ".github/ci/**/*.{js,mjs,ts}",
        "plans/**/acceptance/*.{mjs,mts}"
      ]
    },
    "adapters/sessions/claude": {
      "entry": [
        "src/index.ts",
        "src/provider.ts",
        "src/cli-provider.ts",
        "src/endpoint.ts",
        "src/anthropic-compatible/*.ts",
        "src/sandbox/*.ts"
      ]
    },
    "adapters/sessions/codex": {
      "entry": [
        "src/index.ts",
        "src/agent.ts",
        "src/provider.ts",
        "src/sdk-provider.ts",
        "src/runtime.ts",
        "src/launch.ts"
      ]
    },
    "adapters/sessions/cursor": {
      "entry": [
        "src/index.ts",
        "src/provider.ts",
        "src/permissions.ts",
        "src/bin.ts",
        "src/launch.ts",
        "src/event-mapping.ts",
        "src/workspace.ts"
      ]
    },
    "adapters/sessions/opencode": {
      "entry": [
        "src/index.ts",
        "src/provider.ts",
        "src/mcp-config.ts",
        "src/launch.ts"
      ]
    },
    "builtin/*": {
      "entry": [
        "tools.ts",
        "skills/**/scripts/**/*.{js,mjs,ts}",
        "actions/**/*.{js,mjs,ts}",
        "src/*.{js,mjs,ts}",
        "web/**/*.{js,mjs}",
        "hooks/*/index.ts",
        "server/src/index.ts",
        "deploy/*/index.ts",
        "deploy/*/entry.ts",
        "launchd/*.{mts,mjs,ts}"
      ],
      "ignoreDependencies": [
        "tsx"
      ]
    },
    "builtin/sessions": {
      "entry": [
        "tools.ts",
        "actions/**/*.{js,mjs,ts}",
        "scripts/*.ts",
        "src/*.{js,mjs,ts}",
        "hooks/*/index.ts",
        "server/src/index.ts"
      ],
      "ignoreDependencies": [
        "dotenv",
        "express",
        "@types/express",
        "tsx"
      ]
    },
    "adapters/decisions": {},
    "adapters/embeddings": {},
    "adapters/sessions/completion": {},
"builtin/sessions/sessions-search": {
      "entry": [
        "tools.ts",
        "src/*.{js,mjs,ts}"
      ],
      "ignoreDependencies": [
        "tsx"
      ]
    },
    "builtin/filesystem/*": {
      "entry": [
        "tools.ts",
        "skills/**/scripts/**/*.{js,mjs,ts}",
        "src/*.{js,mjs,ts}",
        "hooks/*/index.ts",
        "server/src/index.ts"
      ],
      "ignoreDependencies": [
        "tsx"
      ]
    },
    "sdk/cli": {
      "entry": [
        "src/index.ts",
        "scripts/**/*.{js,mjs,mts,ts}"
      ]
    },
    "sdk/actions": {
      "entry": [
        "src/index.ts",
        "src/skill-catalog.ts",
        "src/action-catalog.ts",
        "src/action-commands.ts",
        "src/action-index.ts",
        "src/instruction-catalog.ts",
        "src/instruction-index.ts",
        "src/plugin-mount.ts"
      ]
    },
    "sdk/auth": {
      "entry": [
        "src/index.ts"
      ]
    },
    "sdk/services": {
      "entry": [
        "src/index.ts"
      ]
    },
    "sdk/adapters/agents": {
      "entry": [
        "src/index.ts"
      ]
    },
    "sdk/adapters/llms": {
      "entry": [
        "src/index.ts",
        "src/types.ts",
        "src/http.ts",
        "src/prompted-questions.ts"
      ]
    },
    "builtin/sessions/api": {
      "entry": [
        "src/index.ts",
        "src/jobs/*.ts",
        "qa/**/*.{js,cjs,mjs,ts}",
        "scripts/**/*.{ts,mts}"
      ]
    },
    "sdk/engine": {
      "ignoreDependencies": [
        "better-sqlite3"
      ]
    },
    "sdk/lib": {
      "ignoreDependencies": [
        "zod"
      ],
      "entry": [
        "src/bounds/index.ts",
        "src/host/index.ts",
        "qa/mock-bag-server/server.ts"
      ]
    }
  }
}
