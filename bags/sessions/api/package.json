    "@barry-rocks/search-bag": "workspace:*",
    "@barry-rocks/tracker-bag": "workspace:*",
    "better-sqlite3": "12.10.0",
    "express": "4.22.1",
    "ws": "8.21.0",
    "zod": "4.4.3",
    "@barry-rocks/scheduler-service": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "4.17.21",
    "@types/node": "22.15.0",
    "@types/ws": "8.5.13",
    "typescript": "5.9.3",
    "vitest": "4.1.0",
    "@barry-rocks/embedding-ollama": "workspace:*",
    "@barry-rocks/completion-anthropic": "workspace:*",
    "@barry-rocks/completion-ollama": "workspace:*",
    "@barry-rocks/completion-llamacpp": "workspace:*",
