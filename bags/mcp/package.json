{
  "name": "@barry-rocks/mcp-bag",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Barry's MCP server. A composition root: it imports the bags it serves, which the SDK must not.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@barry-rocks/actions-bag": "workspace:*",
    "@barry-rocks/events-bag": "workspace:*",
    "@barry-rocks/identities-bag": "workspace:*",
    "@barry-rocks/locks-bag": "workspace:*",
    "@barry-rocks/schedules-bag": "workspace:*",
    "@barry-rocks/sdk": "workspace:*",
    "@barry-rocks/sessions-bag": "workspace:*",
    "@barry-rocks/tracker-bag": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "mcp-remote": "0.14.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "barry": {
    "build": {
      "externals": [
        "mcp-remote"
      ]
    }
  }
}
