{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "allowJs": true,
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "dist",
    "node_modules"
  ],
  "extends": "../../tsconfig.base.json"
}
