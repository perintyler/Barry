#!/bin/bash
#
# Installs the sudoers rule that `coffee lid-awake` needs.
#
# This is the ONLY part of the coffee bag that requires root, and it is
# optional: without it, lid-awake logs a warning and everything else works
# normally (the caffeinate assertion still holds, `pmset disablesleep` is never
# touched). Run it only if you want the Mac to stay awake with the lid CLOSED.
#
#   bags/coffee/scripts/install-sudoers          # install
#   bags/coffee/scripts/install-sudoers --remove # uninstall
#
# Why root is needed at all: caffeinate cannot keep a Mac awake with the lid
# shut. -d/-i create idle assertions, and lid-close is a FORCED sleep path, so
# idle assertions do not block it. `pmset disablesleep` is the only mechanism
# that does, and it is a persistent system-wide root-owned setting.
#
set -euo pipefail

DEST=/etc/sudoers.d/barry-coffee
USER_NAME="${SUDO_USER:-$(id -un)}"

if [[ "${1:-}" == "--remove" ]]; then
  if [[ -e "$DEST" ]]; then
    sudo rm -f "$DEST"
    echo "removed $DEST"
    echo "note: if sleep is currently disabled, clear it with:"
    echo "  sudo pmset -a disablesleep 0"
  else
    echo "$DEST is not installed; nothing to do"
  fi
  exit 0
fi

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

cat > "$TMP" <<EOF
# Installed by the Barry coffee bag (bags/coffee/scripts/install-sudoers).
#
# Lets the coffee supervisor keep this Mac awake with the LID CLOSED, which
# caffeinate cannot do on its own.
#
# Deliberately two literal commands: no wildcards, no caller-controlled
# arguments. This grants exactly "toggle disablesleep" and nothing else.
#
# The supervisor only runs these on AC power, reverts on every clean exit via
# its EXIT/TERM/INT trap, and a run-at-load reconciler clears an orphaned
# setting at login if the daemon is SIGKILLed or the machine loses power.
#
# To remove: bags/coffee/scripts/install-sudoers --remove
${USER_NAME} ALL=(root) NOPASSWD: /usr/bin/pmset -a disablesleep 1, /usr/bin/pmset -a disablesleep 0
EOF

# Validate BEFORE the file goes anywhere near /etc/sudoers.d. A malformed file
# there can lock you out of sudo entirely, and this check is the whole reason
# this script exists rather than a copy-paste instruction.
if ! visudo -c -f "$TMP" >/dev/null 2>&1; then
  echo "refusing to install: generated sudoers file failed validation" >&2
  visudo -c -f "$TMP" >&2 || true
  exit 1
fi

echo "validated. installing $DEST for user '${USER_NAME}' (requires your password)"
sudo install -o root -g wheel -m 0440 "$TMP" "$DEST"

# Re-validate the whole tree, not just our fragment: a file that parses alone
# can still break the set (e.g. duplicate or conflicting entries).
if ! sudo visudo -c >/dev/null 2>&1; then
  echo "sudoers tree is INVALID after install — rolling back" >&2
  sudo rm -f "$DEST"
  exit 1
fi

echo "installed and verified."
echo
echo "enable lid-closed operation with:"
echo "  barry coffee lid-awake on"
