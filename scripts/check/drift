#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

info() {
  printf "[info] %s\n" "$1"
}

warn() {
  printf "[warn] %s\n" "$1"
}

fail() {
  printf "[fail] %s\n" "$1"
}

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "Missing required command: $1"
    exit 1
  fi
}

source_env_if_present() {
  local env_file="$ROOT_DIR/.env.staging"
  if [[ ! -f "$env_file" ]]; then
    env_file="$ROOT_DIR/.env"
  fi

  if [[ -f "$env_file" ]]; then
    set -a
    # shellcheck disable=SC1091
    source "$env_file"
    set +a
  fi
}

check_caddy_generation() {
  local before_hash after_hash
  local caddyfile="$ROOT_DIR/scripts/launchd/Caddyfile"

  # Hash the file only when it exists. `shasum` on a missing path prints
  # nothing, so an absent Caddyfile hashed to "" both before and after — two
  # empty strings compare EQUAL and the check reported "in sync" for a file
  # that was not there at all. A drift check whose broken state is
  # indistinguishable from its healthy one is worse than no check.
  if [[ ! -f "$caddyfile" ]]; then
    fail "scripts/launchd/Caddyfile is missing — cannot check for drift"
    return 1
  fi
  before_hash="$(shasum -a 256 "$caddyfile" | awk '{print $1}')"

  info "Regenerating Caddy config"
  (
    cd "$ROOT_DIR"
    pnpm tsx scripts/generate-caddy-config.ts public >/tmp/barry-caddy-generate.log 2>&1
  )

  # The generator resolves the path from its own location, so it lands here
  # here because of the `cd` above. If it ever exits 0 without writing, this
  # catches it rather than passing on a stale file.
  if [[ ! -f "$caddyfile" ]]; then
    fail "scripts/launchd/Caddyfile is missing after regeneration — the generator did not write it"
    echo ""
    echo "Generator output: /tmp/barry-caddy-generate.log"
    return 1
  fi
  after_hash="$(shasum -a 256 "$caddyfile" | awk '{print $1}')"

  if [[ -z "$before_hash" || -z "$after_hash" ]]; then
    fail "Could not hash scripts/launchd/Caddyfile — refusing to report it in sync"
    return 1
  fi

  if [[ "$before_hash" != "$after_hash" ]]; then
    fail "Caddy config drift detected after regeneration"
    echo ""
    echo "The generated Caddyfile changed during this check."
    echo ""
    echo "Review with:"
    echo "  git -C \"$ROOT_DIR\" diff -- scripts/launchd/Caddyfile"
    return 1
  fi

  info "Caddy config is in sync"
  return 0
}

terraform_plan_check() {
  local module_dir="$1"
  local module_name="$2"

  # A module directory that is GONE is a bug, not a skip. This function used to
  # fall straight through to the tfvars check below, which returns 0 with a
  # warn -- so a module deleted out from under this list reported "no drift"
  # forever. That is exactly what happened to infra/tailscale. Absent and
  # present-but-unconfigured are different failures and must not collapse into
  # one answer.
  if [[ ! -d "$module_dir" ]]; then
    fail "$module_name: module directory $module_dir does not exist"
    return 1
  fi

  if [[ ! -f "$module_dir/terraform.tfvars" ]]; then
    warn "$module_name: terraform.tfvars missing, skipping drift check"
    return 0
  fi

  if [[ ! -d "$module_dir/.terraform" ]]; then
    info "$module_name: initializing Terraform"
    terraform -chdir="$module_dir" init -input=false -no-color >/tmp/barry-tf-init-"$module_name".log 2>&1
  fi

  info "$module_name: running terraform plan -detailed-exitcode"
  set +e
  terraform -chdir="$module_dir" plan -detailed-exitcode -input=false -no-color >/tmp/barry-tf-plan-"$module_name".log 2>&1
  local code=$?
  set -e

  if [[ $code -eq 0 ]]; then
    info "$module_name: no drift"
    return 0
  fi

  if [[ $code -eq 2 ]]; then
    fail "$module_name: drift detected"
    echo ""
    echo "Inspect with:"
    echo "  terraform -chdir=$module_dir plan"
    return 1
  fi

  fail "$module_name: terraform plan failed (exit $code)"
  echo ""
  echo "Last plan output:"
  tail -n 30 "/tmp/barry-tf-plan-$module_name.log" || true
  return 1
}

check_claude_installed() {
  if ! command -v claude >/dev/null 2>&1; then
    fail "claude not found on PATH — run ./install or: brew install --cask claude-code"
    return 1
  fi

  local installed_version
  installed_version=$(claude --version 2>/dev/null | awk '{print $1}')
  info "Claude CLI installed ($installed_version)"
  return 0
}

usage() {
  cat <<EOF
Check infrastructure/config drift for Barry.

Usage:
  $0 [--skip-terraform]

Options:
  --skip-terraform   Skip terraform plan drift checks
EOF
}

main() {
  local skip_terraform=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skip-terraform) skip_terraform=true; shift ;;
      -h|--help|help) usage; exit 0 ;;
      *) fail "Unknown argument: $1"; usage; exit 1 ;;
    esac
  done

  need_cmd git
  need_cmd jq
  need_cmd rg
  need_cmd pnpm
  if [[ "$skip_terraform" == false ]]; then
    need_cmd terraform
  fi

  source_env_if_present

  local failures=0

  check_caddy_generation || failures=$((failures + 1))
  check_claude_installed || failures=$((failures + 1))

  if [[ "$skip_terraform" == false ]]; then
    # No terraform root lives in this repo any more. Every one is bag-owned and
    # in an external bag repo (cloudflare, mailgun, barry.rocks), reached with
    # `barry bag infra <name> plan` — this script only knows $ROOT_DIR, so it
    # cannot plan them. Said out loud rather than left as an empty branch: a
    # drift check that silently plans nothing reports clean for a reason that
    # has nothing to do with drift.
    warn "No in-repo terraform roots; run 'barry bag infra <name> plan' per bag"
  else
    warn "Skipping terraform drift checks"
  fi

  echo ""
  if [[ $failures -eq 0 ]]; then
    info "No drift detected"
    return 0
  fi

  fail "Drift checks failed ($failures)"
  return 1
}

main "$@"
