#!/usr/bin/env bash
#
# Create the macOS service account a bag service runs as.
#
#   sudo scripts/launchd/install-service-account _barryvault "Barry Vault"
#
# A bag service that declares `user:` runs as a different PRINCIPAL. That is the
# only thing on macOS that separates it from the agent sessions sharing this
# machine: same UID is same trust, so a secret held by a service running as you
# is readable by anything else running as you — `docker inspect`, the
# /usr/bin/security ACL deputy, its own 0600 plist, or attaching to the process.
# A distinct UID is what makes those fail.
#
# This is deliberately NOT part of `scripts/launchd/setup`. Setup runs
# unattended on every `barry pack`; creating users needs root and must be a
# thing someone chooses to do.
#
# Idempotent: re-running against an existing account verifies it and changes
# nothing.

set -euo pipefail

USER_NAME="${1:-}"
REAL_NAME="${2:-${USER_NAME}}"

if [[ -z "$USER_NAME" ]]; then
    echo "usage: sudo $0 <_account> [\"Real Name\"]" >&2
    exit 64
fi

# The leading underscore is the macOS convention for a service account
# (_postgres, _www, _mysql). Enforced because a name without it is most likely a
# real login account, and running a daemon as the human defeats the point.
if [[ ! "$USER_NAME" =~ ^_[a-z0-9][a-z0-9_-]*$ ]]; then
    echo "error: '$USER_NAME' is not a service account name (expected _lowercase)" >&2
    exit 64
fi

if [[ "$(id -u)" != "0" ]]; then
    echo "error: must run as root — creating a user requires it" >&2
    echo "  sudo $0 $USER_NAME" >&2
    exit 77
fi

# Already there: verify rather than recreate, and report the UID so a caller can
# see what it got. Recreating would churn the UID and orphan every file the
# service owns.
if id -u "$USER_NAME" >/dev/null 2>&1; then
    existing_uid="$(id -u "$USER_NAME")"
    echo "✓ $USER_NAME already exists (uid $existing_uid)"
    exit 0
fi

# UID selection is the real trap here.
#
#   - Below 500 keeps the account off the login window. Above it, the account
#     shows up as a user someone can log into.
#   - Apple actively uses 1-304, and _oahd sits at 441. A new macOS release adds
#     accounts in that range, so a hardcoded id can collide later.
#
# 400-440 is the gap between them. Probe it and REFUSE rather than guess: two
# daemons sharing a UID silently merges two trust domains, and nothing about the
# running system would look wrong afterwards.
UID_MIN=400
UID_MAX=440

used_ids="$(dscl . -list /Users UniqueID | awk '{print $2}')"
used_gids="$(dscl . -list /Groups PrimaryGroupID | awk '{print $2}')"

NEW_ID=""
for candidate in $(seq "$UID_MIN" "$UID_MAX"); do
    # Take the id only when BOTH the uid and the matching gid are free, so user
    # and group land on the same number and file ownership stays readable.
    if ! grep -qx "$candidate" <<<"$used_ids" && ! grep -qx "$candidate" <<<"$used_gids"; then
        NEW_ID="$candidate"
        break
    fi
done

if [[ -z "$NEW_ID" ]]; then
    echo "error: no free uid/gid pair in ${UID_MIN}-${UID_MAX} — refusing to guess" >&2
    exit 75
fi

echo "Creating $USER_NAME (uid/gid $NEW_ID)…"

dscl . -create "/Groups/$USER_NAME"
dscl . -create "/Groups/$USER_NAME" PrimaryGroupID "$NEW_ID"
dscl . -create "/Groups/$USER_NAME" RealName "$REAL_NAME"

dscl . -create "/Users/$USER_NAME"
dscl . -create "/Users/$USER_NAME" UniqueID "$NEW_ID"
dscl . -create "/Users/$USER_NAME" PrimaryGroupID "$NEW_ID"
dscl . -create "/Users/$USER_NAME" RealName "$REAL_NAME"
# No login: no shell and no home. Matches _postgres and _oahd, which is also why
# IsHidden is not set — a uid below 500 is already hidden from the login window.
dscl . -create "/Users/$USER_NAME" UserShell /usr/bin/false
dscl . -create "/Users/$USER_NAME" NFSHomeDirectory /var/empty
# No password entry at all, so the account cannot be authenticated as.
dscl . -create "/Users/$USER_NAME" Password "*"

# dscl reports success for writes that did not land the way you asked, so verify
# against the directory rather than trusting the exit codes above.
actual_uid="$(id -u "$USER_NAME" 2>/dev/null || echo "")"
if [[ "$actual_uid" != "$NEW_ID" ]]; then
    echo "error: account creation did not take (wanted uid $NEW_ID, got '${actual_uid:-none}')" >&2
    exit 70
fi

echo "✓ $USER_NAME created (uid/gid $NEW_ID)"
echo
echo "Next:"
echo "  - give the service its data dir:"
echo "      sudo install -d -o $USER_NAME -g $USER_NAME -m 700 /usr/local/var/$USER_NAME"
echo "  - add yourself to its group if you need to reach its socket:"
echo "      sudo dseditgroup -o edit -a \"\$(id -un)\" -t user $USER_NAME"
echo "  - install the LaunchDaemon (root-owned, in /Library/LaunchDaemons)"
