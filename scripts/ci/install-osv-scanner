#!/usr/bin/env bash
set -euo pipefail

if command -v osv-scanner >/dev/null 2>&1; then
  exit 0
fi

version="2.4.0"
platform="$(uname -s | tr '[:upper:]' '[:lower:]')"
machine="$(uname -m)"
case "$machine" in
  x86_64) arch="amd64" ;;
  arm64|aarch64) arch="arm64" ;;
  *) echo "Unsupported OSV Scanner architecture: $machine" >&2; exit 1 ;;
esac

asset="osv-scanner_${platform}_${arch}"
case "$asset" in
  osv-scanner_darwin_amd64) checksum="088119325156321c34c456ac3703d6013538fd71cbac82b891ab34db491e4d66" ;;
  osv-scanner_darwin_arm64) checksum="9ca3185ad63e9ab54f7cb90f46a7362be02d80e37f0123d095a54355ea202f5d" ;;
  osv-scanner_linux_amd64) checksum="15314940c10d26af9c6649f150b8a47c1262e8fc7e17b1d1029b0e479e8ed8a0" ;;
  osv-scanner_linux_arm64) checksum="44e580752910f0ff36ec99aff59af20f65df1e859aa31e5605a8f0d055b496e9" ;;
  *) echo "Unsupported OSV Scanner platform: $asset" >&2; exit 1 ;;
esac

install_dir="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/barry-bin"
mkdir -p "$install_dir"
curl -fsSL "https://github.com/google/osv-scanner/releases/download/v${version}/${asset}" -o "$install_dir/osv-scanner"
echo "$checksum  $install_dir/osv-scanner" | shasum -a 256 -c -
chmod +x "$install_dir/osv-scanner"

if [[ -n "${GITHUB_PATH:-}" ]]; then
  echo "$install_dir" >> "$GITHUB_PATH"
else
  echo "Installed $install_dir/osv-scanner; add $install_dir to PATH."
fi
