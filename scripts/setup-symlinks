#!/bin/bash
# Setup symlinks for Claude Code configuration
# Links ~/.claude/ files to barry repo equivalents

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BARRY_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "Setting up Claude Code symlinks..."

# Create ~/.claude directory if it doesn't exist
mkdir -p ~/.claude

# Link skills directory
if [[ -L ~/.claude/skills ]]; then
    # Already a symlink, remove and recreate
    rm ~/.claude/skills
elif [[ -d ~/.claude/skills ]]; then
    echo -e "${YELLOW}Warning: ~/.claude/skills exists and is not a symlink${NC}"
    echo "Backing up to ~/.claude/skills.bak"
    mv ~/.claude/skills ~/.claude/skills.bak
fi
ln -sf "$BARRY_DIR/skills" ~/.claude/skills
echo -e "  ${GREEN}✓${NC} ~/.claude/skills -> $BARRY_DIR/skills"

# Link barry CLI to ~/bin (create directory if needed)
mkdir -p ~/bin
if [[ -L ~/bin/barry ]]; then
    rm ~/bin/barry
elif [[ -f ~/bin/barry ]]; then
    echo -e "${YELLOW}Warning: ~/bin/barry exists and is not a symlink${NC}"
    echo "Backing up to ~/bin/barry.bak"
    mv ~/bin/barry ~/bin/barry.bak
fi
ln -sf "$BARRY_DIR/cli/src/index.ts" ~/bin/barry
echo -e "  ${GREEN}✓${NC} ~/bin/barry -> $BARRY_DIR/cli/src/index.ts"

# Configure git hooks path
git -C "$BARRY_DIR" config core.hooksPath scripts/git-hooks
echo -e "  ${GREEN}✓${NC} git hooks -> $BARRY_DIR/scripts/git-hooks"

echo ""
echo -e "${GREEN}Setup complete!${NC}"

# Check if ~/bin is in PATH
if [[ ":$PATH:" != *":$HOME/bin:"* ]]; then
    echo ""
    echo -e "${YELLOW}┌─────────────────────────────────────────────────────────┐${NC}"
    echo -e "${YELLOW}│  ~/bin is not in your PATH — the 'barry' command       │${NC}"
    echo -e "${YELLOW}│  won't work until you fix this.                        │${NC}"
    echo -e "${YELLOW}│                                                        │${NC}"
    echo -e "${YELLOW}│  Run:                                                  │${NC}"
    echo -e "${YELLOW}│  echo 'export PATH=\"\$HOME/bin:\$PATH\"' >> ~/.zshrc    │${NC}"
    echo -e "${YELLOW}│  source ~/.zshrc                                       │${NC}"
    echo -e "${YELLOW}└─────────────────────────────────────────────────────────┘${NC}"
fi
